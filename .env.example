# claude code changed: 2026-10-26 — new file. Copy to .env and fill in YOUR values there. Placeholders only: never put
# a real key in this file (it is committed to Git; .env is not).

# Django
QUANTBOT_SECRET_KEY=replace-with-a-long-random-string

# Claude API (Anthropic Console → API keys). Server-side only; never paste it into code, chat or a template.
ANTHROPIC_API_KEY=

# Research Explainer (Academy). Off until you switch it on.
EXPLAINER_AI_ENABLED=false
EXPLAINER_AI_MODEL=claude-haiku-5-5
EXPLAINER_AI_MODEL_RESEARCH=claude-sonnet-5-5
EXPLAINER_MAX_QUESTION_CHARS=500
EXPLAINER_MAX_OUTPUT_TOKENS=2000
EXPLAINER_TIMEOUT_SECONDS=30
EXPLAINER_USER_PER_MINUTE=3
EXPLAINER_USER_PER_DAY=15
EXPLAINER_GLOBAL_PER_DAY=100
EXPLAINER_CACHE_DAYS=7

# Market Intelligence news AI (existing)
MI_AI_ENABLED=true
MI_AI_MAX_CALLS_PER_HOUR=12

# Stripe billing (existing; restricted key rk_... recommended)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
BILLING_ENFORCED=false
